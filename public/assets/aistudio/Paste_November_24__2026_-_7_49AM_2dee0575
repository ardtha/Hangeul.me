function markWrong(item) {
  weak[item.h] = 2; store.set("hg_weak", weak);
  queue.splice(Math.max(0, queue.length - 3), 0, item);
}
function markRight(item) {
  if (weak[item.h]) { weak[item.h]--; if (weak[item.h] <= 0) delete weak[item.h]; store.set("hg_weak", weak); }
}

function mult() { return 1 + Math.floor(streak / 5); }
function hud() {
  $("score").textContent = score;
  $("comboN").textContent = streak; $("mult").textContent = mult();
  $("combo").classList.toggle("hot", streak >= 5);
  $("bestS").textContent = bestStreak;
  $("weakN").textContent = Object.keys(weak).length;
  $("timer").style.display = challenge ? "" : "none";
  $("tLeft").textContent = timeLeft;
  $("timer").classList.toggle("low", challenge && timeLeft <= 10);
}

const card = $("card");
function show() {
  cur = nextCard();
  $("ch").textContent = cur.h;
  $("ch").style.fontSize = cur.h.length > 2 ? "50px" : cur.h.length === 2 ? "68px" : "92px";
  $("bdg").textContent = cur.type; card.dataset.k = cur.kind;
  const isWeak = !!weak[cur.h];
  card.classList.toggle("weak", isWeak);
  $("wk").textContent = isWeak ? "KARTU LEMAH · ULANGI!" : "";
  leftOk = Math.random() < .5;
  $("oL").textContent = leftOk ? cur.c : cur.w;
  $("oR").textContent = leftOk ? cur.w : cur.c;
  card.style.transition = "transform .5s cubic-bezier(.175,.885,.32,1.2)";
  card.style.transform = "none"; card.style.opacity = "1"; card.style.borderColor = "";
  $("flash").style.opacity = "0"; $("flash").className = "";
  $("oL").style.transform = $("oR").style.transform = "scale(1)";
  cx = 0; busy = false; hud();
}

function answer(swipedLeft) {
  if (busy || !cur) return;
  busy = true; total++;
  const ok = swipedLeft ? leftOk : !leftOk;
  const t = $("toast");
  if (ok) {
    right++; streak++; runBest = Math.max(runBest, streak); score += mult();
    if (streak > bestStreak) { bestStreak = streak; store.set("hg_best_streak", bestStreak); }
    markRight(cur);
    t.className = "ok"; t.textContent = `✓ ${cur.c} · ${cur.m}`;
  } else {
    streak = 0; markWrong(cur);
    t.className = "no"; t.textContent = `✗ Jawaban: ${cur.c} · ${cur.m}`;
  }
  $("flash").className = ok ? "fok" : "fno"; $("flash").style.opacity = "1";
  card.style.transition = "all .3s ease-in";
  card.style.transform = `translateX(${swipedLeft ? -innerWidth : innerWidth}px) rotate(${swipedLeft ? -25 : 25}deg)`;
  card.style.opacity = "0";
  hud();
  setTimeout(() => { card.style.transition = "none"; setTimeout(show, 50); }, 250);
}

let drag = false, sx = 0, cx = 0;
const px = e => e.touches ? e.touches[0].clientX : e.clientX;
function dStart(e) { if (busy) return; drag = true; sx = px(e); card.style.transition = "none"; }
function dMove(e) {
  if (!drag || busy) return;
  cx = px(e) - sx;
  card.style.transform = `translateX(${cx}px) rotate(${cx * .08}deg)`;
  card.style.borderColor = cx < -30 ? "var(--red)" : cx > 30 ? "var(--blue)" : "";
  $("oL").style.transform = cx < -30 ? "scale(1.1)" : cx > 30 ? "scale(.9)" : "scale(1)";
  $("oR").style.transform = cx > 30 ? "scale(1.1)" : cx < -30 ? "scale(.9)" : "scale(1)";
}
function dEnd() {
  if (!drag) return; drag = false;
  if (cx < -80) answer(true);
  else if (cx > 80) answer(false);
  else { card.style.transition = "transform .4s cubic-bezier(.175,.885,.32,1.2)"; card.style.transform = "none"; card.style.borderColor = ""; $("oL").style.transform = $("oR").style.transform = "scale(1)"; }
}
card.addEventListener("mousedown", dStart);
card.addEventListener("touchstart", dStart, { passive: true });
addEventListener("mousemove", dMove);
addEventListener("touchmove", dMove, { passive: true });
addEventListener("mouseup", dEnd);
addEventListener("touchend", dEnd);
addEventListener("keydown", e => {
  if (e.key === "ArrowLeft") answer(true);
  else if (e.key === "ArrowRight") answer(false);
  else if (e.key === " ") { e.preventDefault(); speak(); }
});

function speak(t) {
  const txt = typeof t === "string" ? t : (cur && cur.h);
  if (!txt || !("speechSynthesis" in window)) return;
  try {
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(txt);
    u.lang = "ko-KR"; u.rate = .8;
    speechSynthesis.speak(u);
  } catch (e) {}
}
if (!("speechSynthesis" in window)) $("speakBtn").style.display = "none";
$("speakBtn").onclick = speak;

$("modeBtn").onclick = () => {
  if (challenge) return;
  mode = mode === "L" ? "W" : "L";
  $("modeBtn").textContent = mode === "L" ? "Mode: Huruf" : "Mode: Suku Kata";
  queue = []; streak = 0; show();
};

function startChallenge() {
  clearInterval(timerId);
  challenge = true; timeLeft = 60; score = 0; streak = 0; total = 0; right = 0; runBest = 0; queue = [];
  $("chalBtn").classList.add("on"); $("chalBtn").textContent = "⏹ Berhenti";
  $("modeBtn").style.opacity = ".4";
  show();
  timerId = setInterval(() => { timeLeft--; hud(); if (timeLeft <= 0) endChallenge(); }, 1000);
}
function endChallenge() {
  clearInterval(timerId); challenge = false;
  const record = score > bestChal;
  if (record) { bestChal = score; store.set("hg_best_chal", bestChal); }
  $("resT").textContent = record ? "🎉 Rekor baru!" : "Waktu habis!";
  $("resS").textContent = score;
  const acc = total ? Math.round(right / total * 100) : 0;
  $("resD").innerHTML = `Benar <b>${right}</b> dari <b>${total}</b> (${acc}%)<br>Combo terbaik: <b>${runBest}</b><br>Rekor tantangan: <b>${bestChal}</b>`;
  $("resOv").classList.add("active");
  $("chalBtn").classList.remove("on"); $("chalBtn").textContent = "⏱ 60 detik";
  $("modeBtn").style.opacity = "1";
  score = 0; streak = 0; queue = []; busy = true; hud();
}
$("chalBtn").onclick = () => challenge ? endChallenge() : startChallenge();
$("resBtn").onclick = () => { $("resOv").classList.remove("active"); startChallenge(); };
$("resX").onclick = () => { $("resOv").classList.remove("active"); show(); };

function buildDict() {
  const body = $("dictBody"); body.innerHTML = "";
  const chips = $("chips"); chips.innerHTML = "";
  const q = ($("dictQ").value || "").trim().toLowerCase();
  const cats = {};
  ALL.filter(i => !q || [i.h, i.c, i.m, i.type].join(" ").toLowerCase().includes(q)).forEach(i => (cats[i.type] = cats[i.type] || []).push(i));
  if (!Object.keys(cats).length) body.innerHTML = '<div class="res" style="margin-top:20px">Tidak ditemukan.</div>';
  for (const [name, items] of Object.entries(cats)) {
    const t = document.createElement("div"); t.className = "st"; t.textContent = name; body.appendChild(t);
    const c = document.createElement("button"); c.className = "chip"; c.textContent = name + " " + items.length;
    c.onclick = () => t.scrollIntoView({ behavior: "smooth", block: "start" }); chips.appendChild(c);
    const g = document.createElement("div"); g.className = "grid";
    items.forEach(i => {
      const d = document.createElement("div"); d.className = "di" + (weak[i.h] ? " weak" : "");
      d.innerHTML = `<span class="dh"></span><span class="da"></span><span class="dm"></span>`;
      d.children[0].textContent = i.h; d.children[1].textContent = i.c; d.children[2].textContent = i.m; d.onclick = () => speak(i.h);
      g.appendChild(d);
    });
    body.appendChild(g);
  }
}
$("dictBtn").onclick = () => { buildDict(); $("dictOv").classList.add("active"); };
$("dictX").onclick = () => $("dictOv").classList.remove("active");
$("dictQ").oninput = buildDict;

show();
</script>
</body>
</html>
'''

class Handler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(HTML_CONTENT.encode("utf-8"))

if __name__ == "__main__":
    print(f"Server berjalan di http://localhost:{PORT}")
    webbrowser.open(f"http://localhost:{PORT}")
    with socketserver.TCPServer(("", PORT), Handler) as httpd:
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\nServer dihentikan.")