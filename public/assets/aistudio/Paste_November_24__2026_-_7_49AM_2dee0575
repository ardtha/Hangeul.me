    orbs.push({ el, s, x: Math.random() * innerWidth, y: Math.random() * innerHeight, vx: Math.random() - .5, vy: Math.random() - .5 });
  }
  (function tick() {
    orbs.forEach(o => {
      o.x += o.vx; o.y += o.vy;
      if (o.x <= 0 || o.x + o.s >= innerWidth) o.vx *= -1;
      if (o.y <= 0 || o.y + o.s >= innerHeight) o.vy *= -1;
      o.el.style.transform = `translate(${o.x}px,${o.y}px)`;
